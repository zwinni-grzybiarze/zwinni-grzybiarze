# Copy to .env and fill in. Used by compose.yml and compose.live.yml.
# ASP.NET Core maps __ to : (Jwt__Secret → Jwt:Secret).

Jwt__Secret=
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Frontend__Url=http://localhost:18000

# SMTP (Mailgun SMTP user + password). Required outside Development/Testing.
# Same style as Overleaf/Rallly stacks: smtp.eu.mailgun.org + mailbox user/pass.
Smtp__Host=smtp.eu.mailgun.org
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__User=onlyshrooms@mail.ohmmycode.dev
Smtp__Password=your-mailgun-smtp-password
Smtp__From=OnlyShrooms <onlyshrooms@mail.ohmmycode.dev>
